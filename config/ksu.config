# =============================================================================
# DarkniusX - KernelSU Next add-on fragment
# =============================================================================
# This file is NOT a standalone kernel config. The build script concatenates:
#
#     config/base.config + config/ksu.config
#
# into the effective KSU variant config.
#
# KernelSU Next v3.4.2 requires:
#   CONFIG_KPROBES=y   (already in gki_defconfig)
#   CONFIG_EXT4_FS=y   (already in gki_defconfig)
#
# There is no CONFIG_KSU_KPROBES_HOOK symbol in v3.4.2. Older KernelSU
# documentation mentions it; adding it here would simply be ignored.
# =============================================================================

CONFIG_KSU=y
# CONFIG_KSU_DEBUG is not set
# CONFIG_KSU_DISABLE_MANAGER is not set
# CONFIG_KSU_DISABLE_POLICY is not set
