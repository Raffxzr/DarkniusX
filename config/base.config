# =============================================================================
# DarkniusX - base kernel config fragment
# =============================================================================
# Applied AFTER arch/arm64/configs/gki_defconfig and before olddefconfig.
# This file is shared by the Vanilla and KernelSU Next variants.
#
# Design goals:
#   * keep GKI KMI generation 9 (android12-5.10) compatible with vendor modules
#   * remove debug instrumentation that is NOT part of the GKI KMI
#   * keep the hardening and layout-sensitive options that Android expects
#
# Do not add random "magic" performance options here. Measure first.
# =============================================================================

# Clean, deterministic release string. CONFIG_MODVERSIONS is enabled by GKI,
# so the kernel release prefix is ignored when vendor modules are loaded; only
# the vermagic flags and symbol CRCs matter. Do not disable MODVERSIONS.
CONFIG_LOCALVERSION="-DarkniusX"
# CONFIG_LOCALVERSION_AUTO is not set

# -----------------------------------------------------------------------------
# What we remove (safe: no GKI KMI symbols, no vendor struct layout changes)
# -----------------------------------------------------------------------------
# UBSAN handlers are exported, but they are not in the GKI KMI symbol lists, so
# they are already trimmed by TRIM_NONLISTED_KMI=1. Removing UBSAN here only
# removes the checks from the kernel image itself.
#
# KFENCE is a sampling allocator debugger. It has no GKI KMI symbols and does
# not add fields to struct page/module/task_struct.
# -----------------------------------------------------------------------------
# CONFIG_UBSAN is not set
# CONFIG_KFENCE is not set

# -----------------------------------------------------------------------------
# What we MUST keep (and why)
# -----------------------------------------------------------------------------
# KASAN (HW_TAGS) is intentionally kept:
#   - mm/kasan/hw_tags.c exports kasan_flag_enabled
#   - kasan_flag_enabled is in the GKI KMI symbol lists
#   - disabling KASAN makes the KMI check fail (and can break vendor modules)
#
# PAGE_OWNER is intentionally kept:
#   - page_owner_inited, __set_page_owner, get_page_owner_handle are in some
#     GKI KMI symbol lists
#
# DEBUG_LIST is intentionally kept:
#   - __list_add_valid and __list_del_entry_valid are in the GKI KMI lists
#   - vendor modules compiled with CONFIG_DEBUG_LIST expect those symbols
#
# SCHEDSTATS / SCHED_DEBUG are intentionally kept:
#   - they add fields to struct sched_entity / struct task_struct
#   - vendor modules are compiled against the stock GKI layout; disabling them
#     can shift field offsets (current->pid, current->cred, etc.)
#
# Keep: CFI_CLANG, SHADOW_CALL_STACK, HARDENED_USERCOPY, INIT_ON_ALLOC_DEFAULT_ON,
#       MODVERSIONS, SELinux, KASAN, PAGE_OWNER, DEBUG_LIST, SCHEDSTATS,
#       SCHED_DEBUG.
#
# MODULE_SCMVERSION depends on LOCALVERSION_AUTO. We keep LOCALVERSION_AUTO
# disabled so `uname -r` stays `5.10.272-DarkniusX`; losing the cosmetic
# scmversion modinfo attribute has no effect on module loading or ABI.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Intentionally left alone
# -----------------------------------------------------------------------------
# CONFIG_DEBUG_INFO is kept enabled. It does not affect runtime performance and
# it makes crash reports / pstore / ramoops output actually useful. If build
# time or disk space becomes a problem, disabling it is safe:
#
#   # CONFIG_DEBUG_INFO is not set
#   # CONFIG_DEBUG_INFO_DWARF4 is not set
#
# CONFIG_INIT_ON_ALLOC_DEFAULT_ON is kept enabled for security. Disabling it
# saves a small amount of CPU in allocation-heavy workloads, but it weakens a
# real Android hardening feature; use a separate "aggressive" profile if you
# really want that trade-off.

# -----------------------------------------------------------------------------
# Reference: options already set by the Scalar-based gki_defconfig
# -----------------------------------------------------------------------------
# CONFIG_PREEMPT=y
# CONFIG_HZ=250
# CONFIG_TCP_CONG_BBR=y
# CONFIG_TCP_CONG_CUBIC is not set
# CONFIG_DEFAULT_FQ_CODEL=y
# CONFIG_MQ_IOSCHED_ADIOS=y
# CONFIG_IOSCHED_BFQ=y
# CONFIG_PELT_UTIL_HALFLIFE_12=y
# CONFIG_RT_SOFTINT_OPTIMIZATION=y
# CONFIG_LTO_CLANG_FULL=y
# CONFIG_CFI_CLANG=y
